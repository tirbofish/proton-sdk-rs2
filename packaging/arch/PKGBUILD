pkgname=pdcli
pkgver=0.4.0
pkgrel=1
pkgdesc='Unofficial Proton Drive desktop and command-line client'
arch=('x86_64' 'aarch64')
url='https://github.com/tirbofish/proton-sdk-rs2'
license=('MIT')
depends=('fuse3' 'gtk3' 'gtk4' 'libadwaita' 'libxdo' 'libayatana-appindicator')
makedepends=('cargo' 'protobuf' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::https://github.com/tirbofish/proton-sdk-rs2/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/proton-sdk-rs2-$pkgver"
  cargo build --locked --release -p pdcli
}

package() {
  cd "$srcdir/proton-sdk-rs2-$pkgver"
  install -Dm755 target/release/pdcli "$pkgdir/usr/bin/pdcli"
  install -Dm755 target/release/pdcli-gui "$pkgdir/usr/bin/pdcli-gui"
  install -Dm644 packaging/io.github.tirbofish.pdcli.desktop \
    "$pkgdir/usr/share/applications/io.github.tirbofish.pdcli.desktop"
  install -Dm644 packaging/systemd/pdcli.service \
    "$pkgdir/usr/lib/systemd/user/pdcli.service"
  install -Dm644 packaging/icons/hicolor/scalable/apps/io.github.tirbofish.pdcli.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.tirbofish.pdcli.svg"
  install -Dm644 packaging/io.github.tirbofish.pdcli.open-document.desktop \
    "$pkgdir/usr/share/applications/io.github.tirbofish.pdcli.open-document.desktop"
  install -Dm644 packaging/mime/io.github.tirbofish.pdcli.xml \
    "$pkgdir/usr/share/mime/packages/io.github.tirbofish.pdcli.xml"
  install -Dm644 -t "$pkgdir/usr/share/icons/hicolor/scalable/mimetypes" \
    packaging/icons/hicolor/scalable/mimetypes/application-vnd.proton.doc.svg \
    packaging/icons/hicolor/scalable/mimetypes/application-vnd.proton.sheet.svg
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
