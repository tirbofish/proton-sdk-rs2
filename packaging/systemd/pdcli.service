[Unit]
Description=pdcli filesystem daemon (unofficial Proton Drive client)
# The daemon reads its session from the desktop Secret Service, which is only
# reliably available once the graphical session is up.
PartOf=graphical-session.target
After=graphical-session.target
# Keep retrying while the keyring or network is still coming up after login.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/pdcli daemon --no-tray
Restart=on-failure
RestartSec=15
TimeoutStopSec=30

[Install]
WantedBy=graphical-session.target
