#!/usr/bin/make -f

%:
	dh $@ --buildsystem=none

override_dh_auto_build:
	cargo build --locked --release -p pdcli

override_dh_auto_install:
	install -Dm755 target/release/pdcli debian/pdcli/usr/bin/pdcli
	install -Dm755 target/release/pdcli-gui debian/pdcli/usr/bin/pdcli-gui
	install -Dm644 packaging/io.github.tirbofish.pdcli.desktop debian/pdcli/usr/share/applications/io.github.tirbofish.pdcli.desktop
	install -Dm644 packaging/systemd/pdcli.service debian/pdcli/usr/lib/systemd/user/pdcli.service
	install -Dm644 packaging/icons/hicolor/scalable/apps/io.github.tirbofish.pdcli.svg debian/pdcli/usr/share/icons/hicolor/scalable/apps/io.github.tirbofish.pdcli.svg
	install -Dm644 packaging/io.github.tirbofish.pdcli.open-document.desktop debian/pdcli/usr/share/applications/io.github.tirbofish.pdcli.open-document.desktop
	install -Dm644 packaging/mime/io.github.tirbofish.pdcli.xml debian/pdcli/usr/share/mime/packages/io.github.tirbofish.pdcli.xml
	install -Dm644 packaging/icons/hicolor/scalable/mimetypes/application-vnd.proton.doc.svg debian/pdcli/usr/share/icons/hicolor/scalable/mimetypes/application-vnd.proton.doc.svg
	install -Dm644 packaging/icons/hicolor/scalable/mimetypes/application-vnd.proton.sheet.svg debian/pdcli/usr/share/icons/hicolor/scalable/mimetypes/application-vnd.proton.sheet.svg
