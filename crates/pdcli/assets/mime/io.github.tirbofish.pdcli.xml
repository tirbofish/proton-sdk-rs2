<?xml version="1.0" encoding="UTF-8"?>
<!-- Shortcut files that pdcli's mount shows for Proton Docs and Sheets. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.proton.doc">
    <comment>Proton Docs document</comment>
    <icon name="application-vnd.proton.doc"/>
    <generic-icon name="x-office-document"/>
    <magic priority="90">
      <match type="string" offset="0" value="{&quot;proton_drive_document&quot;:&quot;doc&quot;"/>
    </magic>
  </mime-type>
  <mime-type type="application/vnd.proton.sheet">
    <comment>Proton Sheets spreadsheet</comment>
    <icon name="application-vnd.proton.sheet"/>
    <generic-icon name="x-office-spreadsheet"/>
    <magic priority="90">
      <match type="string" offset="0" value="{&quot;proton_drive_document&quot;:&quot;sheet&quot;"/>
    </magic>
  </mime-type>
</mime-info>
